# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pustak_market_ems?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=pustak_market_ems_jwt_secret_key_2026_super_secure
JWT_EXPIRE=30d

# ==================================================
# EMAIL NOTIFICATION SYSTEM CONFIGURATION
# ==================================================
# Option 1: Gmail SMTP (Use App Password generated from Google Account Security)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password
FROM_EMAIL=noreply@pustakmarket.com
FROM_NAME=Pustak Market EMS

# Option 2: Brevo (Sendinblue) SMTP
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_login_email
# SMTP_PASS=your_brevo_smtp_key

# ==================================================
# CLOUDINARY FILE STORAGE (Primary Storage)
# ==================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==================================================
# OFFICE LOCATION GEOFENCING (Attendance Radius)
# ==================================================
OFFICE_LAT=28.6139
OFFICE_LNG=77.2090
OFFICE_RADIUS_METERS=500
ENABLE_GEOFENCING=true
