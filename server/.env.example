# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pustak_market_ems?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=pustak_market_ems_jwt_secret_key_2026_super_secure
JWT_EXPIRE=30d

# ==================================================
# EMAIL NOTIFICATION SYSTEM CONFIGURATION (Brevo / Bravo SMTP)
# ==================================================
EMAIL_SERVICE=brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=b407d5001@smtp-brevo.com
BREVO_SMTP_USER=b407d5001@smtp-brevo.com
BREVO_API_KEY=your_brevo_api_key_here
SMTP_PASS=your_brevo_api_key_here
FROM_EMAIL=noreply@pustakmarket.com
FROM_NAME=Pustak Market EMS

# ==================================================
# CLOUDINARY FILE STORAGE (Primary Storage)
# ==================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==================================================
# OFFICE LOCATION GEOFENCING (Attendance Radius)
# ==================================================
OFFICE_LAT=28.6139
OFFICE_LNG=77.2090
OFFICE_RADIUS_METERS=500
ENABLE_GEOFENCING=true
