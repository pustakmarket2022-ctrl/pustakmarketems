# Server Port
PORT=5000

# Environment Mode (development / production)
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas recommended for Render)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pustak_market_ems?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=pustak_market_ems_jwt_secret_key_2026_super_secure
JWT_EXPIRE=30d

# SMTP Configuration (Optional: Mailtrap, SendGrid, Gmail, etc.)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
FROM_EMAIL=noreply@pustakmarket.com
FROM_NAME=Pustak Market HR System

# Frontend URL (For CORS if enabled)
CLIENT_URL=https://your-vercel-frontend-url.vercel.app
