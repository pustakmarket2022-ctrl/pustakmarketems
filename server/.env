# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration
MONGO_URI=mongodb+srv://pustakmarket:pustakmarket@cluster0.xjapc2q.mongodb.net/pustak_market_ems?retryWrites=true&w=majority

# JWT Security
JWT_SECRET=pustak_market_ems_jwt_secret_key_2026_super_secure
JWT_EXPIRE=30d

# Email Notification System (Gmail SMTP / Brevo SMTP / Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL=noreply@pustakmarket.com
FROM_NAME=Pustak Market EMS

# Cloudinary Storage Credentials (Primary File Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Office Location Geofencing Settings for Attendance
OFFICE_LAT=28.6139
OFFICE_LNG=77.2090
OFFICE_RADIUS_METERS=500
ENABLE_GEOFENCING=true
